# Demo mode (local file store with seeded data)
# Set to "true" for local development only. Demo mode is blocked in production.
# When false or unset, Supabase configuration is required.
ENABLE_DEMO_MODE=true

# Supabase configuration (required when ENABLE_DEMO_MODE is false or in production)
# When these are set with ENABLE_DEMO_MODE=true, the app still uses demo mode.
# When ENABLE_DEMO_MODE is false or unset, these must be configured for authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
